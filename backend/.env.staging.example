# Teglion Backend — template STAGING (versionável)
# Preferir preencher o .env.staging na raiz do monorepo; este ficheiro
# documenta o subconjunto backend. Nunca secrets reais aqui.

NODE_ENV=development
PORT=8001
PRODUCT_MODE=contabil
LOG_LEVEL=info

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=contabil-documents

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
DATA_ENCRYPTION_KEY=
DOCUMENTS_SIGNING_SECRET=

# Em Render staging (remoto), usar exactamente:
# FRONTEND_URL=https://staging.teglion.com
# PUBLIC_API_URL=https://teglion-api-staging.onrender.com
# CORS_ORIGINS=https://staging.teglion.com
# GOOGLE_OAUTH_REDIRECT_URI=https://teglion-api-staging.onrender.com/api/auth/google/callback
# (Nunca staging.teglion.com/api/... — Vercel reescreve /api para produção.)
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
ALLOW_BEARER_AUTH=false

REDIS_URL=

BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=
SMS_ENABLED=false

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://teglion-api-staging.onrender.com/api/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=https://teglion-api-staging.onrender.com/api/contabil/integrations/google-calendar/callback
GOOGLE_PICKER_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_ENABLED=true
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_PLATFORM_FEE_BPS=200
STRIPE_PRICE_ID_EUR_MONTHLY=
STRIPE_PRICE_ID_EUR_YEARLY=

SENTRY_DSN=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

BACKUP_DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
BACKUP_DRY_RUN=true

# Teglion Backend — variáveis de ambiente
# Copia para .env (git-ignored) e preenche com valores REAIS apenas em produção/staging.
# Em desenvolvimento local, usa valores de teste/dummy — nunca copiar segredos live para cá.

NODE_ENV=development
PORT=8001
PRODUCT_MODE=contabil

# --- Supabase (obrigatório) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=contabil-documents

# --- JWT (obrigatório, único por ambiente — nunca partilhar entre local/staging/produção) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Encriptação de dados sensíveis (obrigatório em produção) ---
DATA_ENCRYPTION_KEY=
DOCUMENTS_SIGNING_SECRET=

# --- CORS / Frontend ---
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=
PUBLIC_API_URL=

# --- Cookies ---
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
COOKIE_SECURE=false
ALLOW_BEARER_AUTH=false

# --- Redis (rate limit distribuído — obrigatório em produção multi-instância) ---
REDIS_URL=

# --- Email transaccional (Brevo) ---
BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=

# --- Google OAuth (SSO staff) ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
# Redirect da integração Google Calendar (diferente da SSO). Em falta, infere-se de PUBLIC_API_URL.
GOOGLE_CALENDAR_REDIRECT_URI=
# API Key do Google Picker (HTTP referrer restricted no GCP — não é um secret clássico).
# Necessária para importar ficheiros do Drive via Picker. Ver docs/operations/GOOGLE_DRIVE_PICKER_SETUP.md
GOOGLE_PICKER_API_KEY=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Connect (clientes → escritório) — LIVE: true + whsec do endpoint Connected accounts
STRIPE_CONNECT_ENABLED=true
STRIPE_CONNECT_WEBHOOK_SECRET=
# Taxa Teglion em basis points (200 = 2%) sobre pagamentos Connect dos clientes
STRIPE_CONNECT_PLATFORM_FEE_BPS=200
STRIPE_PRICE_ID_EUR_MONTHLY=
STRIPE_PRICE_ID_EUR_YEARLY=

# --- Observabilidade ---
SENTRY_DSN=
LOG_LEVEL=info

# --- Backup PostgreSQL → Cloudflare R2 (Render Cron Job; NÃO no frontend) ---
# Connection string Direct ou Session :5432 — NUNCA Transaction pooler :6543
BACKUP_DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=teglion-backups-prod
R2_ENDPOINT=
BACKUP_RETENTION_DAILY_DAYS=14
BACKUP_RETENTION_WEEKLY_COUNT=8
BACKUP_RETENTION_MONTHLY_COUNT=12
BACKUP_DRY_RUN=false
# Opcional:
# BACKUP_LOCK_PATH=
# BACKUP_WORK_DIR=
# PG_DUMP_BIN=pg_dump
# PG_ISREADY_BIN=pg_isready


# --- Cloudflare Turnstile (secret só no backend — nunca no frontend) ---
# Widget produção: "Teglion Production" (Managed), hostnames www.teglion.com + teglion.com
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=www.teglion.com,teglion.com

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Cron interno ---
CRON_SECRET=

# --- Operador legal (RGPD / avisos legais) ---
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_NIF=
LEGAL_OPERATOR_EMAIL=
LEGAL_OPERATOR_PHONE=
LEGAL_OPERATOR_LOCATION=
LEGAL_OPERATOR_CAE=

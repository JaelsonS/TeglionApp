# Teglion Frontend — STAGING (Vite)
# Copiar para .env.staging.local (git-ignored). Nunca secrets.
# npm run dev -- --mode staging   (quando o mode staging estiver activo)

VITE_API_BASE_URL=http://localhost:8001
VITE_ALLOW_API_BASE_QUERY=false
VITE_MAX_FILE_SIZE_MB=25
VITE_ENABLE_PWA=true
VITE_PRODUCT_MODE=contabil
VITE_ADSENSE_LIVE=false

# Depois de existir API staging remota:
# VITE_API_BASE_URL=https://teglion-api-staging.onrender.com

VITE_SENTRY_DSN=
VITE_APP_VERSION=
VITE_SENTRY_RELEASE=
VITE_TURNSTILE_SITE_KEY=

# Teglion Frontend — variáveis de ambiente (Vite)
# Copia para .env.local (git-ignored). Todas as vars expostas ao browser
# devem começar com VITE_ — nunca colocar segredos aqui.

VITE_API_BASE_URL=http://localhost:8001
VITE_ALLOW_API_BASE_QUERY=false

VITE_MAX_FILE_SIZE_MB=25
VITE_ENABLE_PWA=true

# Sentry (opcional)
VITE_SENTRY_DSN=
VITE_APP_VERSION=
VITE_SENTRY_RELEASE=

# AdSense (opcional, blog público)
VITE_ADSENSE_LIVE=false

# Cloudflare Turnstile (sitekey pública — nunca o secret)
# Em produção: sitekey do widget "Teglion Production"
# Em local: deixar vazio (backend faz skip sem TURNSTILE_SECRET_KEY) ou usar keys de teste Cloudflare
VITE_TURNSTILE_SITE_KEY=

# Teglion — template STAGING (seguro para versionar)
# Copiar para .env.staging na raiz do monorepo (git-ignored) e preencher.
# Nunca colocar secrets reais neste ficheiro.
#
# Ver também: docs/operations/GIT_WORKFLOW.md, docs/operations/DEPLOY_STAGING.md

# --- Application ---
NODE_ENV=development
PORT=8001
PRODUCT_MODE=contabil
LOG_LEVEL=info

# --- Supabase STAGING ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=contabil-documents

# --- JWT / crypto (valores NOVOS só para staging) ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
DATA_ENCRYPTION_KEY=
DOCUMENTS_SIGNING_SECRET=
LEGACY_CRYPTO_PASSPHRASE=
ALLOW_BEARER_AUTH=false
COOKIE_DOMAIN=
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# --- URLs (local até existir staging.teglion.com + API staging) ---
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8001
CORS_ORIGINS=http://localhost:3000

# --- Google OAuth / Calendar staging ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_PICKER_API_KEY=

# --- Stripe TEST (nunca sk_live_) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_ENABLED=true
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_CONNECT_PLATFORM_FEE_BPS=200
STRIPE_PRICE_ID_EUR_MONTHLY=
STRIPE_PRICE_ID_EUR_YEARLY=

# --- Brevo staging ---
BREVO_API_KEY=
FROM_EMAIL=
FROM_NAME=
SMS_ENABLED=false

# --- Redis / storage / backup (opcional local) ---
REDIS_URL=
BACKUP_DATABASE_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
BACKUP_DRY_RUN=true

# --- Turnstile / cron / push / legal / sentry ---
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAMES=
CRON_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_NIF=
LEGAL_OPERATOR_EMAIL=
LEGAL_OPERATOR_PHONE=
LEGAL_OPERATOR_LOCATION=
LEGAL_OPERATOR_CAE=
SENTRY_DSN=

# --- Frontend Vite (também em frontend/.env.staging.example) ---
VITE_API_BASE_URL=http://localhost:8001
VITE_ALLOW_API_BASE_QUERY=false
VITE_MAX_FILE_SIZE_MB=25
VITE_ENABLE_PWA=true
VITE_PRODUCT_MODE=contabil
VITE_TURNSTILE_SITE_KEY=
VITE_SENTRY_DSN=

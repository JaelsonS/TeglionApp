# Imagem dedicada ao Render Cron Job de backup PostgreSQL → Cloudflare R2.
# Inclui Node.js + clientes PostgreSQL 17 (pg_dump / pg_restore).
# (Supabase prod está em PG 17; o client Debian bookworm default é 15 e falha.)
#
# Build (raiz do monorepo):
#   docker build -f Dockerfile.backup -t teglion-backup .
#
# Run:
#   docker run --rm --env-file backend/.env teglion-backup

FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    openssl \
  && curl -fsSL https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    | gpg --dearmor -o /usr/share/keyrings/postgresql-archive-keyring.gpg \
  && echo "deb [signed-by=/usr/share/keyrings/postgresql-archive-keyring.gpg] http://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
    > /etc/apt/sources.list.d/pgdg.list \
  && apt-get update \
  && apt-get install -y --no-install-recommends postgresql-client-17 \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copiar apenas o necessário para o job (evita contexto frontend).
COPY backend/package.json backend/package-lock.json ./backend/
RUN cd backend && npm ci --omit=dev

COPY backend/ ./backend/

WORKDIR /app/backend

RUN pg_dump --version && pg_restore --version && node --version

ENV NODE_ENV=production

CMD ["node", "scripts/backup-postgres-to-r2.js"]
